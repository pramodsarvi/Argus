# /etc/vlmpipe/vlmpipe.env  (chmod 640, owned by root:vlmpipe)
MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VLLM_BASE_URL=http://127.0.0.1:8000/v1
# VLLM_API_KEY=            # set the same value for vllm + worker if you enable auth
FRAMES_DIR=/mnt/nvme/frames
PROMPTSETS_PATH=/opt/vlmpipe/configs/promptsets.yaml
TEMPORAL_ADDRESS=temporal.internal:7233
KAFKA_BOOTSTRAP=kafka.internal:9092
DATABASE_URL=postgresql://vlmpipe@db.internal/vlmpipe
# NODE_NAME=gpu-vm-01       # optional. Default = hostname. Worker and ingest MUST resolve to the same
#                           # value (Temporal queue is node-<NODE_NAME>); set it explicitly if hostnames change.
PROFILE=balanced            # or: latency (8 frames x ~128 tokens)
ANALYSIS_MODE=bundle        # or: two_tier
SAMPLE_CONCURRENCY=4        # parallel ffmpeg; default min(4, cpus/2)
VLM_MAX_INFLIGHT=4          # chunks analysed at once per replica
METRICS_PORT=9100
