[Unit]
Description=vlmpipe results
After=network-online.target
Wants=network-online.target

[Service]
User=vlmpipe
WorkingDirectory=/opt/vlmpipe
EnvironmentFile=/etc/vlmpipe/vlmpipe.env
ExecStart=/opt/vlmpipe/.venv/bin/python -m vlmpipe.results.service
Restart=always
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/mnt/nvme
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
